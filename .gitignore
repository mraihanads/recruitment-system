# Root Git Ignore for RecruitMatch

# Dependencies
node_modules/
vendor/

# Environment files
.env
.env.backup
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Build output
frontend/dist/
frontend/dist-ssr/
public/build/
public/hot

# Storage & Cache (Laravel)
backend/storage/*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*.log
!backend/storage/logs/.gitignore
backend/public/storage

# Testing & Logs
.phpunit.cache/
.phpunit.result.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS files
.idea/
.vscode/*
!.vscode/extensions.json
.fleet/
Homestead.json
Homestead.yaml
auth.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
